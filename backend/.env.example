# ============================================================
# Multimodal RAG Studio — Environment Configuration
# Copy this file to .env and adjust values as needed.
# ============================================================

# ---------- App ----------
APP_NAME=Multimodal RAG Studio
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Uploads / Storage ----------
UPLOAD_DIR=../data/uploads
EXTRACTED_IMAGES_DIR=../data/extracted_images
MAX_UPLOAD_MB=50
ALLOWED_PDF_MAX_PAGES=500

# ---------- Qdrant ----------
# Use "local" mode (embedded, no Docker) or "remote" (Docker/server)
QDRANT_MODE=local
QDRANT_PATH=../data/qdrant_storage
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_TEXT=mm_rag_text
QDRANT_COLLECTION_IMAGES=mm_rag_images

# ---------- Embedding models ----------
# Dedicated text embedding model for long document chunks
TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CLIP model for cross-modal (text <-> image) embeddings
CLIP_MODEL=sentence-transformers/clip-ViT-B-32
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

# ---------- Chunking ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---------- Retrieval ----------
TOP_K_TEXT=5
TOP_K_IMAGES=5
TEXT_RETRIEVAL_WEIGHT=0.6
IMAGE_RETRIEVAL_WEIGHT=0.4
SCORE_THRESHOLD=0.0

# ---------- LLM / VLM ----------
# Provider: "ollama" or "openai_compatible"
LLM_PROVIDER=ollama
LLM_MODEL=llava:7b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=120

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI-compatible settings (used when LLM_PROVIDER=openai_compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=meta-llama/llama-3.2-11b-vision-preview

# ---------- Chat ----------
MAX_HISTORY_MESSAGES=10
